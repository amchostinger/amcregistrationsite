# ============================================================
# AMC 2027 Conference Registration Site — Environment Variables
# Copy this file to .env and fill in all values
# NEVER commit .env to version control
# ============================================================

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=amc_conference_2027
# Session timezone for MySQL AND the mysql2 driver. These must agree, and must
# match the zone NOW()/CURRENT_TIMESTAMP is written in, or stored times shift.
# Harare is +02:00 year-round (no DST).
DB_TIMEZONE=+02:00

# Clerk (Admin Authentication)
# Get from https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Paynow Zimbabwe
# Get from https://www.paynow.co.zw/Account/Integration
PAYNOW_INTEGRATION_ID=your_integration_id
PAYNOW_INTEGRATION_KEY=your_integration_key
PAYNOW_RESULT_URL=https://yourdomain.com/api/payments/paynow-result
PAYNOW_RETURN_URL=https://yourdomain.com/payment-status

# Resend Email
# Get from https://resend.com/api-keys
# NOTE: the from-address domain must be a *verified sending domain* in Resend.
# amcconference2027.org is verified; africamethodistcouncil.org is not.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=AMC 2027 Conference <conference@amcconference2027.org>
# Admin alerts (new registration / payment received) are addressed here.
ADMIN_NOTIFICATION_EMAIL=communications@africamethodistcouncil.org
# Every delegate-facing email is blind-copied here, so the desk holds the same
# copy the delegate received. Replies are routed to EMAIL_REPLY_TO.
EMAIL_ARCHIVE_ADDRESS=communications@africamethodistcouncil.org
EMAIL_REPLY_TO=communications@africamethodistcouncil.org

# Frontend (Vite) — prefix with VITE_ to expose to browser
VITE_API_URL=http://localhost:5000/api
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
