# ============================================================
# AMC 2027 Conference Registration Site — Environment Variables
# Copy this file to .env and fill in all values
# NEVER commit .env to version control
# ============================================================

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=amc_conference_2027

# Clerk (Admin Authentication)
# Get from https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Paynow Zimbabwe
# Get from https://www.paynow.co.zw/Account/Integration
PAYNOW_INTEGRATION_ID=your_integration_id
PAYNOW_INTEGRATION_KEY=your_integration_key
PAYNOW_RESULT_URL=https://yourdomain.com/api/payments/paynow-result
PAYNOW_RETURN_URL=https://yourdomain.com/payment-status

# Resend Email
# Get from https://resend.com/api-keys
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=conference@africamethodistcouncil.org
ADMIN_NOTIFICATION_EMAIL=genesec@africamethodistcouncil.org

# Frontend (Vite) — prefix with VITE_ to expose to browser
VITE_API_URL=http://localhost:5000/api
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
